{
  "name": "resume-generator",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm check:architecture && pnpm check:test-conventions && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:architecture": "dependency-cruiser --config dependency-cruiser.config.cjs apps packages",
    "check:test-conventions": "node scripts/check-test-conventions.mjs",
    "dev": "turbo run dev --filter=@resume-tailoring/web",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:evaluation": "pnpm --filter @resume-tailoring/web test:evaluation",
    "test:e2e": "pnpm --filter @resume-tailoring/web test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
