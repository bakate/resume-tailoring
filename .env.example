# The one Language Model Provider every model role uses; only Qualified Model Configurations of it are accepted.
# Only the active provider's key is required.
LANGUAGE_MODEL_PROVIDER=deepseek
# DeepSeek, the provider production runs on: deepseek-flash qualifies for both roles (BAK-167, BAK-168). Thinking and
# output budgets are frozen per operation in its Qualified Model Configuration; only the model of each role is a setting.
DEEPSEEK_API_KEY=
DEEPSEEK_STRUCTURED_MODEL=deepseek-flash
DEEPSEEK_WRITING_MODEL=deepseek-flash
# OpenAI stays implemented and qualified as a dormant alternative (LANGUAGE_MODEL_PROVIDER=openai).
# OPENAI_API_KEY=
# OPENAI_STRUCTURED_MODEL=gpt-6-luna
# OPENAI_STRUCTURED_REASONING_EFFORT=low
# OPENAI_WRITING_MODEL=gpt-6-sol
# OPENAI_WRITING_REASONING_EFFORT=medium
# Optional fallbacks are accepted only after the same reference suite qualifies them.
# OPENAI_STRUCTURED_FALLBACK_MODEL=gpt-6-luna
# OPENAI_STRUCTURED_FALLBACK_REASONING_EFFORT=low
# OPENAI_WRITING_FALLBACK_MODEL=gpt-6-sol
# OPENAI_WRITING_FALLBACK_REASONING_EFFORT=medium
DEMO_ACCESS_MODE=disabled
# Production only. Generate DEMO_SESSION_SECRET with at least 32 random characters.
# DEMO_SESSION_SECRET=
# DEMO_ORIGIN_SECRET=
# DEMO_PUBLIC_HOSTNAME=resume-studio.bakateba.workers.dev
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
