{
  "name": "@resume-tailoring/web",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:pdf": "vitest run --maxWorkers=1 src/pdf-capacity/pdf-capacity-benchmark.evaluation.test.ts --reporter=verbose",
    "build": "vite build",
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --passWithNoTests --exclude 'test/**' --exclude '**/*.evaluation.test.ts'",
    "test:evaluation": "vitest run --maxWorkers=1 src/model-evaluation/section-preparation-qualification.evaluation.test.ts src/adapters/server/openai-job-match-evidence-matcher.evaluation.test.ts",
    "test:qualification": "vitest run --maxWorkers=1 src/model-evaluation/cross-segment-qualification.test.ts src/model-evaluation/general-management-qualification.test.ts src/model-evaluation/sales-commercial-qualification.test.ts src/model-evaluation/cross-segment-document-qualification.test.ts src/model-evaluation/cross-segment-document-qualification.evaluation.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:compatibility": "playwright test --project=chromium-desktop --project=chromium-mobile --project=firefox-desktop --project=firefox-mobile --project=webkit-desktop --project=webkit-mobile",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@mantine/core": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@resume-tailoring/application": "workspace:*",
    "@resume-tailoring/matching-engine": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "nitro": "catalog:",
    "pdfjs-dist": "6.3.289",
    "puppeteer": "25.12.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "26.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
